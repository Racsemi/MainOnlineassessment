# ==============================================================================
# RACSEMI Assess - Production Environment Configuration Template
# ==============================================================================

# Server & Runtime
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/racsemi_assess?schema=public"

# Redis & Background Queue
REDIS_URL="redis://localhost:6379"

# JWT & Authentication Security
JWT_SECRET="racsemi_super_secret_jwt_access_key_minimum_32_chars_2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="racsemi_super_secret_jwt_refresh_key_minimum_32_chars_2026"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="racsemi_secure_cookie_secret_key_prod_grade_2026"

# Email Configuration (SMTP / Mock)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="placeholder_smtp_user"
SMTP_PASSWORD="placeholder_smtp_password"
EMAIL_FROM="RACSEMI Recruitment <no-reply@racsemi.com>"
EMAIL_MOCK=true

# S3 Compatible File Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="racsemi-assess-reports"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE=true

# Code Execution Engine
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MAX_MEMORY_MB=256
CODE_RUNNER_MAX_CODE_SIZE_KB=100
CODE_RUNNER_MAX_CONCURRENT=4
CODE_RUNNER_DOCKER_ENABLED=false

# Anti-Cheat & Integrity Settings
INTEGRITY_MAX_TAB_SWITCHES=5
INTEGRITY_MAX_FULLSCREEN_EXITS=3
INTEGRITY_RETENTION_DAYS=30

# Next.js Public Variables
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="RACSEMI Assess"
NEXT_PUBLIC_COMPANY_NAME="RACSEMI"
